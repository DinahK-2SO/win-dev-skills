                        },
                        {
                          "type": "Text",
                          "name": "Scaled packaged assets",
                          "className": "TextBlock",
                          "isEnabled": true,
                          "isOffscreen": false,
                          "x": 872,
                          "y": 1063,
                          "width": 1199,
                          "height": 95,
                          "selector": "lbl-scaledpackageda-8027",
                          "isInvokable": false
                        },
                        {
                          "type": "Text",
                          "name": "The framework can select an asset from your package based on the current DPI. Include multiple versions of each asset using the following naming convention: image.scale-100.png, image.scale-140.png and image.scale-180.png. When you use \u0022image.png\u0022 within your app, Windows will select an asset based on the current scale.\r\n\r\nThe XAML framework selects the image when the view is first loaded and will also change the asset if the scale changes (for example, if the app is moved to a different monitor). No additional code is required for dynamic reloading.\r\n\r\nNote: Text has been added to the image above in order to make clear which version of the image is loaded.",
                          "className": "TextBlock",
                          "isEnabled": true,
                          "isOffscreen": true,
                          "x": 0,
                          "y": 0,
                          "width": 0,
                          "height": 0,
                          "selector": "lbl-theframeworkcan-8028",
                          "isInvokable": false
                        },
                        {
